# Ysyry — variables de entorno
# Copiar a .env (local) o pasar como env al deploy. IMPORTANTE: NEXT_PUBLIC_* se inlinean en build-time.

# URL base de la API (sin trailing slash; el código concatena los endpoints)
NEXT_PUBLIC_API_URL=https://ysyry-api.vectrapy.com/api

# URL publica del sitio (usada para canonical/SEO/OpenGraph)
NEXT_PUBLIC_SITE_URL=https://ysyry.com.py

# Puerto del contenedor (Dockerfile EXPOSE + PORT)
PORT=7074
